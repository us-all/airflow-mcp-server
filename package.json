{
  "name": "@us-all/airflow-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.us-all/airflow",
  "description": "Airflow MCP server \u2014 DAG list, runs, task instances, log tails, trigger and clear over the Airflow REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "airflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "pnpm run build",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@us-all/mcp-toolkit": "^1.2.3",
    "dotenv": "^17.4.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "hono": "^4.12.18",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/us-all/airflow-mcp-server"
  },
  "license": "MIT"
}
